<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nightscout Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nightscout URL (e.g. https://yoursite.herokuapp.com)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nightscout_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="API Secret"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/api_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/upload_interval_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload Interval: 5 minutes"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/upload_interval_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="5.0"
        android:valueTo="60.0"
        android:stepSize="5.0"
        android:value="5.0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/scan_duration_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan Duration: 5 seconds"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/scan_duration_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1.0"
        android:valueTo="15.0"
        android:stepSize="1.0"
        android:value="5.0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/scan_interval_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan Interval: 1 minute"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/scan_interval_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1.0"
        android:valueTo="5.0"
        android:stepSize="1.0"
        android:value="1.0"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/enable_upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Nightscout Upload"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/enable_health_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Google Health Connect Sync"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/grant_health_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Health Connect Permissions"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>

    <Button
        android:id="@+id/open_health_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Health Connect Settings"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>

    <TextView
        android:id="@+id/selected_device_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selected Device: None"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/select_device_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Device"
        android:layout_marginBottom="24dp" />

</LinearLayout>
